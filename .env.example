# 서버 설정
NODE_ENV=development
PORT=20128
HOST=127.0.0.1

# 데이터베이스 (SQLite for development, PostgreSQL for production)
DATABASE_URL=sqlite:./data/router.db
# DATABASE_URL=postgresql://user:password@localhost:5432/router

# 암호화 키 (32바이트 hex, 한 번 생성 후 절대 변경 금지!)
# 생성: openssl rand -hex 32
ENCRYPTION_KEY=your_32_byte_hex_key_here

# 관리자 API 키
# 생성: openssl rand -base64 48
ADMIN_API_KEY=admin_your_secure_key_here

# 로그 설정
LOG_LEVEL=info
LOG_PRETTY=true

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_FREE=20
RATE_LIMIT_MAX_PRO=100

# CORS (프론트엔드 주소)
CORS_ORIGIN=http://localhost:3000
